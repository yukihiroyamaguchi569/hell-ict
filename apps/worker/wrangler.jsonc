{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hell-ict-development-harness",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MODEL": "gpt-4o",
    "OPENAI_API_KEY": "",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TEAM_ROOM",
        "class_name": "TeamRoom",
      },
      {
        "name": "RACE_LEADERBOARD",
        "class_name": "RaceLeaderboard",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HarnessCounter"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["HarnessCounter"],
      "new_sqlite_classes": ["TeamRoom", "RaceLeaderboard"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
