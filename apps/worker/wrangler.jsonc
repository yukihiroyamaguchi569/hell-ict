{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hell-ict",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MODEL": "gpt-4o",
  },
  // テストプレイ用の静的配信。/api/* は必ずWorkerへ届かせ、それ以外の
  // パスだけAssetsから返す（scripts/build-testplay.shが生成するpublic/を配信対象とする）。
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"],
  },
  // テストプレイ当日の進捗記録用。database_idはプレースホルダであり、実在のDBを指していない。
  // デプロイ直前に `wrangler d1 create hell-ict-testplay` を実行し、出力された実IDへ
  // 差し替えること。差し替えないままdeployすると本番で進捗記録だけが落ちる
  // （--dry-runとローカル実行はプレースホルダのままでも通る）。
  // スキーマは ./schema/progress.sql。src/progress.tsのensureSchemaが初回アクセス時にも
  // CREATE TABLE IF NOT EXISTSを流すので、適用忘れでリクエストが落ちることはない。
  "d1_databases": [
    {
      "binding": "PROGRESS_DB",
      "database_name": "hell-ict-testplay",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TEAM_ROOM",
        "class_name": "TeamRoom",
      },
      {
        "name": "RACE_LEADERBOARD",
        "class_name": "RaceLeaderboard",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HarnessCounter"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["HarnessCounter"],
      "new_sqlite_classes": ["TeamRoom", "RaceLeaderboard"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
